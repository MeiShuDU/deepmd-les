        0.999
      ],
      "note": "deepmd Adam betas are (0.9, 0.999); not settable"
    },
    "warmup_steps": 2250,
    "warmup_note": "cace warmup_steps=5 counts EPOCHS (5 * 450 = 2250 optimizer steps)",
    "max_grad_norm": 10.0,
    "force_weight": 1000.0,
    "energy_weight_to_pref_e": "natoms=1566 x w_E, undoing deepmd's per-atom energy loss",
