*.ckpt-*.pt

# This published tree carries code and documentation, not data. The campaign
# frames, checkpoints and analysis dumps live next to their scripts in the
# working copy but are deliberately not published here.
*.npy
*.npz
*.pt
*.pth
*.xyz
*.tar
*.tgz
